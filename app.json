{
  "expo": {
    "name": "IOU",
    "slug": "iou-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.kailee.iou20",
    "universalLinks": {
      "ios": {
        "applinks": "com.kailee.iou20"
      },
      "android": {
        "intentFilters": [
          {
            "action": "VIEW",
            "autoVerify": true,
            "data": [
              {
                "scheme": "https",
                "host": "kailee.iou20.com"
              }
            ],
            "category": [
              "BROWSABLE",
              "DEFAULT"
            ]
          }
        ]
      }
    },
    "icon": "./assets/appstore.png",
    "splash": {
      "image": "./assets/splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9f7f4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.kailee.iou20",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "venmo",
          "venmo"
        ],
        "NSContactsUsageDescription": "This app needs access to your contacts to help you find and connect with people you know, and to use your contact photo as your default profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kailee.iou20",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to scan receipts and extract expense information.",
          "cameraPermission": "The app accesses your camera to take photos of receipts for expense scanning."
        }
      ],
      "expo-file-system",
      [
        "expo-contacts",
        {
          "contactsPermission": "The app accesses your contacts to help find people you know who are already on the app, invite others to join the app, and to optionally use your contact photo as your default profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccec82eb-e35c-4a30-8f92-d9bb9049b111"
      }
    }
  }
}