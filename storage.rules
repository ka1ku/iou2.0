rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - users can only upload their own profile pictures
    match /profile_pictures/{userId}/{filename} {
      // Allow read access to anyone authenticated
      allow read: if request.auth != null;
      
      // Allow write access only to the user who owns this profile picture
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Validate file size (max 5MB for profile pictures)
      allow write: if request.resource.size < 5 * 1024 * 1024;
      
      // Validate file type (only images)
      allow write: if request.resource.contentType.matches('image/.*');
    }
    
    // Receipt images - users can upload receipt images
    match /receipts/{userId}/{filename} {
      // Allow read access to the user who owns the receipt
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow write access to the user who owns the receipt
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Validate file size (max 10MB for receipts)
      allow write: if request.resource.size < 10 * 1024 * 1024;
      
      // Validate file type (only images)
      allow write: if request.resource.contentType.matches('image/.*');
    }
    
    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

